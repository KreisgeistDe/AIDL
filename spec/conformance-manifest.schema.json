{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidl.example/spec/conformance/1/conformance-manifest.schema.json",
  "title": "AIDL conformance surface manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "scope", "statusValues", "surfaces"],
  "properties": {
    "$schema": {"const": "./conformance-manifest.schema.json"},
    "schemaVersion": {"const": 1},
    "scope": {"const": "repository-support-surfaces"},
    "statusValues": {
      "const": ["specified", "experimental", "partial", "implemented", "blocked"]
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "summary", "supportStatement", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
        "kind": {"enum": ["profile", "contract", "tooling", "runtime", "release", "repository"]},
        "status": {"enum": ["specified", "experimental", "partial", "implemented", "blocked"]},
        "summary": {"type": "string", "minLength": 1},
        "supportStatement": {"type": "string", "minLength": 1},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "type": {"enum": ["source", "test", "schema", "registry", "workflow", "documentation", "roadmap", "package-contract", "release-contract"]}
            }
          }
        }
      }
    }
  }
}
