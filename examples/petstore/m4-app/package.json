{
  "name": "@aidl/petstore-m4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "generate": "cd ../../.. && python3 -m tools.m4_petstore generate",
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/build.test.js",
    "test:e2e": "node --test dist/test/e2e.test.js",
    "migrate": "node dist/src/migrate.js",
    "smoke": "node dist/src/smoke.js",
    "start": "node dist/src/server.js",
    "verify": "npm run generate && npm run build && npm test"
  },
  "dependencies": {
    "fastify": "5.6.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}
